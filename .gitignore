# Java / Maven
target/
*.class

# Python
__pycache__/
*.pyc
venv/
.venv/

# Regenerable data: python legacy/generate_input.py, legacy/legacy_batch.py,
# and java-service (mvn spring-boot:run) each regenerate everything under
# data/; see the README's "Building and running" section for exact commands.
data/*.txt
data/*.csv

# Regenerable: java -cp migration-agent/target/classes:migration-agent/target/lib/*
# com.manasv.batchmigration.legacysql.Main migration_results.json (see
# migration-agent/README section of the main README). 1,000 statements plus
# their transpiled SQL is too large to track; docs/ under migration-agent/
# keeps the summarized, honest-sized output instead.
migration_results.json
migration-agent/migration_results.json

# Go
migration-agent/review-queue/review-queue
migration-agent/review-queue/*.exe

# IDE / logs
.idea/
.vscode/
*.log
