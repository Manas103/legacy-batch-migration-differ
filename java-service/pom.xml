<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.4</version>
    <relativePath/>
  </parent>

  <groupId>com.manasv</groupId>
  <artifactId>batch-migration-differ</artifactId>
  <version>1.0.0</version>
  <name>legacy-batch-migration-differ</name>
  <description>
    Spring Boot reimplementation of a fixed-width EOD position batch, built
    to be run in parallel against the legacy Python implementation and
    compared record-for-record by the differ.
  </description>

  <properties>
    <java.version>17</java.version>
    <maven.compiler.release>17</maven.compiler.release>
    <pitest.version>1.17.0</pitest.version>
    <pitest-junit5.version>1.2.1</pitest-junit5.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>batch-migration-differ</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <!-- Merge-gate mutation testing, same pattern as the sibling repo
           merge-gate-ai-authored-pull-requests: pitest-maven with the
           JUnit 5 plugin. targetClasses/targetTests are overridden per
           migration task from the harness (-DtargetClasses=...) to scope
           each run to the class the agent actually touched, so a surviving
           mutant names the exact line the merge gate is judging, not the
           whole codebase. -->
      <plugin>
        <groupId>org.pitest</groupId>
        <artifactId>pitest-maven</artifactId>
        <version>${pitest.version}</version>
        <dependencies>
          <dependency>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-junit5-plugin</artifactId>
            <version>${pitest-junit5.version}</version>
          </dependency>
        </dependencies>
        <configuration>
          <targetClasses>
            <param>com.manasv.batchmigration.calc.*</param>
          </targetClasses>
          <targetTests>
            <param>com.manasv.batchmigration.calc.*</param>
          </targetTests>
          <mutators>
            <mutator>CONDITIONALS_BOUNDARY</mutator>
            <mutator>NEGATE_CONDITIONALS</mutator>
            <mutator>MATH</mutator>
            <mutator>INCREMENTS</mutator>
            <mutator>TRUE_RETURNS</mutator>
            <mutator>FALSE_RETURNS</mutator>
            <mutator>PRIMITIVE_RETURNS</mutator>
            <mutator>EMPTY_RETURNS</mutator>
            <mutator>INVERT_NEGS</mutator>
          </mutators>
          <outputFormats>
            <outputFormat>XML</outputFormat>
            <outputFormat>CSV</outputFormat>
          </outputFormats>
          <threads>8</threads>
          <timestampedReports>false</timestampedReports>
          <exportLineCoverage>true</exportLineCoverage>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
